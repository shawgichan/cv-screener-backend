TYPESAFE_API_KEY=your_typesafe_token_here
EXTRACTION_API_KEY=your_extraction_token_here

# Uncomment and set below based on your provider
# Official TypeSafe API: https://api.typesafe.ai/v1/systemone (PROVIDER_ID=official)
# Reseller API: https://jevtypesafeai.com/api/v1/decide (PROVIDER_ID=reseller)
TYPESAFE_API_URL=https://...
PROVIDER_ID=reseller

PORT=8083

# Advanced Configurations (Defaults shown)
# SERVER_READ_TIMEOUT_SECS=10
# SERVER_WRITE_TIMEOUT_SECS=120
# SERVER_IDLE_TIMEOUT_SECS=120

# CORS_ALLOW_ORIGIN=*
# CORS_ALLOW_METHODS=POST, OPTIONS
# CORS_ALLOW_HEADERS=Content-Type

# MAX_CVS_PER_REQUEST=10
# MAX_CONCURRENCY=10
# RATE_LIMIT_PER_DAY=5
# MAX_BODY_BYTES=2097152

# API_TIMEOUT_SECS=60
# MAX_RETRIES=3
# RETRY_BASE_DELAY_MS=500

# EXTRACTION_MODEL=gemini-2.5-flash-lite
# GLOBAL_API_THROTTLE_MS=100
# JD_EXTRACTION_MAX_RETRIES=3
# JD_EXTRACTION_RETRY_DELAY_MS=200

# MATCH_THRESHOLD_HIGH=0.7
# MATCH_THRESHOLD_LOW=0.3
